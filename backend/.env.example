PORT=8080
APP_CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-1-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
# Keep this set to the same Supabase Session Pooler URL for Docker Compose.
DATABASE_URL_DOCKER=postgresql://postgres.your-project-ref:your-password@aws-1-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
# Same Supabase project as the frontend's NEXT_PUBLIC_SUPABASE_URL /
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY — used to verify incoming bearer tokens.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Service role key (Project Settings > API) — used server-side only, to mint
# signed Storage upload/download URLs for application file uploads.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: the separate f26-technical-challenge server's GET /admin/lookup
# endpoint — lets reviewers see an applicant's scheduler-challenge score.
# CHALLENGE_SERVER_URL defaults to the live deployment if unset.
# CHALLENGE_ADMIN_TOKEN needs the real shared secret (see that repo's
# ADMIN_TOKEN); leave it unset to skip the feature entirely.
CHALLENGE_SERVER_URL=https://fall26-challenge.generatenu.com
CHALLENGE_ADMIN_TOKEN=
